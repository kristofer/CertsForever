# Copy to .env and edit. Never commit .env.

# "production" enforces https and a real domain in CERTS_BASE_URL.
# Use "development" (and http://localhost:8080) to try it locally.
CERTS_ENV=production

# Permanent public origin. Every certificate URL is built from this.
CERTS_BASE_URL=https://certs.example.org

# Used by the Caddy profile (docker compose --profile tls). Hostname only.
CERTS_DOMAIN=certs.example.org

# Admin API bearer token (32+ chars). Generate with: openssl rand -hex 32
# Leave empty to disable the admin API. Alternatively mount a file and set
# CERTS_ADMIN_TOKEN_FILE=/run/secrets/admin_token instead.
CERTS_ADMIN_TOKEN=

# Encrypts secrets at rest (two-step verification). Required in production.
# Generate once with: openssl rand -hex 32   and back it up with the database:
# losing it means every administrator must set up two-step verification again.
CERTS_MASTER_KEY=

# Outgoing email for sign-in links and invitations (STARTTLS on 587, or
# smtps:// on 465). Without it, sign people in with `certsforever login-link EMAIL`.
CERTS_SMTP_URL=
CERTS_MAIL_FROM=CertsForever <certs@example.org>
# Your email provider's bounce/complaint webhook posts to /hooks/email/bounce
# with this token (32+ chars; openssl rand -hex 32). Empty disables it.
CERTS_BOUNCE_WEBHOOK_TOKEN=

# Name shown on pages that belong to no single client (verify, errors).
# Each client's own name, site, blurb and LinkedIn ID are set with
# `certsforever client add/update`, not here.
CERTS_PLATFORM_NAME=CertsForever

# Leave this out. Set it to false only if the container fails to start with
# "exec /usr/local/bin/certsforever: operation not permitted", which happens
# when Docker is installed as a Snap. Better: install Docker from docker.com's
# apt repository instead of the Snap, and keep the protection on.
# CERTS_NO_NEW_PRIVILEGES=false

# Image tag used by compose builds, and the host port on 127.0.0.1.
CERTS_VERSION=dev
CERTS_PORT=8080
